# Public Firebase app config; never put service-account or Gemini API secrets here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Public reCAPTCHA v3 site key (used only when no Enterprise key is set).
VITE_APPCHECK_SITE_KEY=
# Optional public score-based reCAPTCHA Enterprise Web key from the same Firebase project.
# When set it takes precedence over VITE_APPCHECK_SITE_KEY. Never put a secret key or debug token here.
VITE_APPCHECK_ENTERPRISE_SITE_KEY=
# Supply an available cloud model from your Firebase AI Logic console.
VITE_CLOUD_MODEL=gemini-3.5-flash-lite

# Optional development-only boolean opt-in. Never put a debug token here.
VITE_APPCHECK_DEBUG=false
